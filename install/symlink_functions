#!/usr/bin/env bash

ensure_file_symlink_is_in_place() {
    local source="$1"
    local destination="$2"
    local dir

    dir="$(dirname -- "$destination")"
    mkdir -p -- "$dir"

    # If destination is a real file, preserve it before replacing it.
    #
    # -L is used separately because -e returns false for broken symlinks.
    if [ -L "$destination" ]; then
        echo "'$destination' is already a symlink; ensuring it points to '$source'"
    elif [ -e "$destination" ]; then
        if [ -d "$destination" ]; then
            echo "ERROR: '$destination' is a directory; refusing to replace it" >&2
            return 1
        fi

        echo "'$destination' exists; backing it up to '$destination.bak'"
        mv -- "$destination" "$destination.bak"
    else
        echo "'$destination' does not exist"
    fi

    # -s = symbolic link
    # -f = remove existing destination
    # -n = don't dereference destination symlink
    # -T = treat destination as a file, not a directory
    ln -sfnT -- "$source" "$destination"
}


ensure_file_symlink_is_in_place_as_sudo() {
    local source="$1"
    local destination="$2"
    local dir

    dir="$(dirname -- "$destination")"
    mkdir -p -- "$dir"

    if [ -L "$destination" ]; then
        echo "'$destination' is already a symlink; ensuring it points to '$source'"
    elif [ -e "$destination" ]; then
        if [ -d "$destination" ]; then
            echo "ERROR: '$destination' is a directory; refusing to replace it" >&2
            return 1
        fi

        echo "'$destination' exists; backing it up to '$destination.bak'"
        sudo mv -- "$destination" "$destination.bak"
    else
        echo "'$destination' does not exist"
    fi

    sudo ln -sfnT -- "$source" "$destination"
}


